{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elegance.local/schemas/engenharia-projetos-tecnicos/projeto-tecnico/1.0.0",
  "title": "Projeto técnico (núcleo comum) 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["versaoSchema", "dominio", "documento", "itens", "pendencias", "alertasSeguranca"],
  "properties": {
    "versaoSchema": { "enum": ["1.0.0", "1.1.0"] },
    "dominio": { "type": "string", "minLength": 1 },
    "documento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arquivo"],
      "properties": {
        "arquivo": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "paginas": { "type": "integer", "minimum": 1 },
        "classificacao": { "type": "string" }
      }
    },
    "itens": { "type": "array", "items": { "$ref": "#/definitions/Item" } },
    "cotas": { "type": "array", "items": { "$ref": "#/definitions/Cota" } },
    "contagens": { "type": "array", "items": { "$ref": "#/definitions/Contagem" } },
    "pendencias": { "type": "array", "items": { "$ref": "#/definitions/Pendencia" } },
    "alertasSeguranca": { "type": "array", "items": { "$ref": "#/definitions/Alerta" } },
    "historico": { "type": "array", "items": { "$ref": "#/definitions/Historico" } }
  },
  "definitions": {
    "Origem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arquivo", "pagina", "trecho"],
      "properties": {
        "arquivo": { "type": "string", "minLength": 1 },
        "pagina": { "type": ["integer", "null"], "minimum": 1 },
        "trecho": { "type": "string" },
        "regiao": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
        "chave": { "type": "string" },
        "entradas": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "Confirmacao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["por", "em"],
      "properties": {
        "por": { "type": "string", "minLength": 1 },
        "em": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+(Z|[+-]\\d{2}:?\\d{2})?)?$" },
        "nota": { "type": "string" }
      }
    },
    "ValorRastreavel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "valor", "unidade", "estado", "confianca", "metodo", "origem"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "valor": { "type": ["number", "string", "null"] },
        "unidade": { "type": ["string", "null"], "enum": ["mm", "un", "kg", "m2", null] },
        "estado": { "type": "string", "enum": ["confirmado", "inferido", "ausente", "conflitante"] },
        "confianca": { "type": "number", "minimum": 0, "maximum": 1 },
        "metodo": { "type": "string", "enum": ["texto_vetorial", "ocr", "leitura_visual", "calculado", "configuracao", "informado_humano"] },
        "origem": { "$ref": "#/definitions/Origem" },
        "regra": { "type": "string", "minLength": 1 },
        "confirmacao": { "$ref": "#/definitions/Confirmacao" },
        "candidatos": { "type": "array", "items": { "$ref": "#/definitions/ValorRastreavel" } }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "estado": { "const": "conflitante" } }, "required": ["estado"] },
          "then": { "type": "object", "required": ["candidatos"], "properties": { "candidatos": { "type": "array", "minItems": 2 } } }
        },
        {
          "if": { "type": "object", "properties": { "metodo": { "const": "calculado" } }, "required": ["metodo"] },
          "then": {
            "type": "object",
            "required": ["regra"],
            "properties": { "origem": { "type": "object", "required": ["entradas"] } }
          }
        }
      ]
    },
    "MapaDeValores": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/ValorRastreavel" }
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tipo", "quantidade", "dimensoes", "atributos"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tipo": { "type": "string", "minLength": 1 },
        "quantidade": { "$ref": "#/definitions/ValorRastreavel" },
        "dimensoes": { "$ref": "#/definitions/MapaDeValores" },
        "atributos": { "$ref": "#/definitions/MapaDeValores" }
      }
    },
    "Cota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "descricao", "total", "parciais"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "descricao": { "type": "string" },
        "total": { "$ref": "#/definitions/ValorRastreavel" },
        "parciais": { "type": "array", "items": { "$ref": "#/definitions/ValorRastreavel" } }
      }
    },
    "Contagem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "descricao", "declarado", "contado"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "descricao": { "type": "string" },
        "declarado": { "$ref": "#/definitions/ValorRastreavel" },
        "contado": { "$ref": "#/definitions/ValorRastreavel" }
      }
    },
    "Pendencia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tipo", "mensagem", "refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tipo": {
          "type": "string",
          "enum": ["ausente", "conflitante", "inferido_sem_confirmacao", "divergencia", "unidade_ambigua", "texto_suspeito"]
        },
        "mensagem": { "type": "string", "minLength": 1 },
        "refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "pagina": { "type": "integer", "minimum": 1 },
        "paginas": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      }
    },
    "Historico": {
      "type": "object",
      "additionalProperties": false,
      "required": ["em", "por", "acao", "ids"],
      "properties": {
        "em": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+(Z|[+-]\\d{2}:?\\d{2})?)?$" },
        "por": { "type": "string", "minLength": 1 },
        "acao": { "type": "string", "minLength": 1 },
        "ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "nota": { "type": "string" },
        "detalhes": { "type": "object" }
      }
    },
    "Alerta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trecho", "pagina", "motivo"],
      "properties": {
        "trecho": { "type": "string" },
        "pagina": { "type": ["integer", "null"], "minimum": 1 },
        "motivo": { "type": "string", "minLength": 1 }
      }
    }
  }
}
